# Скопируй в .env и заполни. .env НЕ коммитить.
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_CHAT_ID=your-numeric-chat-id      # куда слать утренний пуш (узнать: /start)
GEMINI_API_KEY=put-your-gemini-key-here    # Google AI Studio, free tier
LLM_PROVIDER=gemini                         # gemini | (позже: anthropic/openai)
LLM_MODEL=gemini-3.6-flash            # при снятии модели клиент сам падает на gemini-flash-latest
TIMEZONE=Europe/Samara
MORNING_PUSH_HOUR=8
MORNING_PUSH_MINUTE=0
DB_PATH=data/coach.db
